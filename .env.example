# ---------------------------------------------------------------------------
# TEMPLATE ONLY — THIS FILE IS COMMITTED TO GIT.
# Never put a real key in here. Copy it to `.env` (which is git-ignored) and
# fill the values there. GitHub push protection will block a push that carries
# a real key in this file.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — enables AI muhurat suggestions on the Muhurat page.
# Without it the local rules engine answers instead.
# Key from https://aistudio.google.com/apikey — put it in .env, not here.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validPerson(p) {
      return p.keys().hasAll(['name', 'ymd', 'answers', 'uid'])
        && p.name is string && p.name.size() > 0 && p.name.size() <= 24
        && p.ymd is int && p.ymd >= 19000101 && p.ymd <= 21001231
        && p.answers is list && p.answers.size() == 3
        && p.uid is string;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && roomId.matches('^[A-Z2-9]{6}$')
        && request.resource.data.v == 1
        && request.resource.data.status == 'waiting'
        && request.resource.data.b == null
        && validPerson(request.resource.data.a)
        && request.resource.data.a.uid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.b == null
        && request.resource.data.a == resource.data.a
        && request.resource.data.v == resource.data.v
        && request.resource.data.status == 'complete'
        && validPerson(request.resource.data.b)
        && request.resource.data.b.uid == request.auth.uid;

      allow delete: if false;
    }
  }
}
